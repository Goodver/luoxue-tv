{
  "manifest_version": 2,
  "name": "gv-bridge",
  "version": "1.5",
  "description": "洛雪TV 遥控器输入桥：让 GeckoView 页面响应遥控器点击/滚动/悬停/拖动",
  "applications": {
    "gecko": {
      "id": "gv-bridge@luoxue.tv"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": ["<all_urls>", "nativeMessaging", "geckoViewAddons", "nativeMessagingFromContent"]
}
